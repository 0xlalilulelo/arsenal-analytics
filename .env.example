# ─────────────────────────────────────────────────────────────────────────────
# Arsenal Analytics — Environment Variables
# Copy this file to .env (local dev) or configure in your hosting provider.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev:  postgresql://arsenal:arsenal_dev@localhost:5432/arsenal_analytics
# Production: connection string from Neon / Supabase / Railway
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# For Neon (serverless pooled):
# DATABASE_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=15"

# ── Auth (NextAuth v5 / Auth.js) ─────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="your-64-char-secret-here"
AUTH_URL="https://your-domain.com"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NODE_ENV="production"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="billing@your-domain.com"

# ── Stripe (optional — online invoice payments) ───────────────────────────────
# https://dashboard.stripe.com/apikeys — use sk_test_ / pk_test_ in staging
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxx"

# ── Seed (dev / staging only) ────────────────────────────────────────────────
# Password for demo users when running: pnpm db:seed
SEED_PASSWORD="Arsenal2025!"
