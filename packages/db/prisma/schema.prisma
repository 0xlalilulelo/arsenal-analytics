generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organization (multi-tenant root) ───────────────────────────────────────

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  laborRates    LaborRate[]
  technicians   Technician[]
  customers     Customer[]
  workOrders    WorkOrder[]
  invoices      Invoice[]
  parts         Part[]
  purchaseOrders PurchaseOrder[]
  users         User[]
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  email         String       @unique
  name          String?
  role          UserRole     @default(TECHNICIAN)
  createdAt     DateTime     @default(now())

  accounts      Account[]
  sessions      Session[]
  technicianProfile Technician?
}

enum UserRole { OWNER MANAGER TECHNICIAN PARTS_CLERK ACCOUNTANT }

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Customers & Aircraft ────────────────────────────────────────────────────

model Customer {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  name          String
  email         String?
  phone         String?
  address       String?
  billingTerms  BillingTerms @default(NET_30)
  accountNumber String?
  creditLimit   Float?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  aircraft      Aircraft[]
  workOrders    WorkOrder[]
  invoices      Invoice[]
}

enum BillingTerms { NET_15 NET_30 NET_45 COD PREPAY }

model Aircraft {
  id           String    @id @default(cuid())
  nNumber      String    @unique   // FAA registration (e.g. N12345)
  make         String              // Cessna, Piper, Beechcraft
  model        String              // 172S, PA-28, A36
  serial       String
  year         Int?
  ttsn         Float?              // Total Time Since New (airframe hours)
  engineTtsn   Float?              // Engine time since new/overhaul
  propTtsn     Float?
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workOrders   WorkOrder[]
}

// ─── Work Orders ─────────────────────────────────────────────────────────────

model WorkOrder {
  id             String          @id @default(cuid())
  orgId          String
  org            Organization    @relation(fields: [orgId], references: [id])
  number         String          @unique   // WO-2025-0042
  type           WorkOrderType   @default(SCHEDULED)
  status         WorkOrderStatus @default(OPEN)
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  aircraftId     String
  aircraft       Aircraft        @relation(fields: [aircraftId], references: [id])
  dateOpened     DateTime        @default(now())
  estimatedClose DateTime?
  closedAt       DateTime?
  billingModel   BillingModel    @default(TIME_AND_MATERIALS)
  nteAmount      Float?          // Not-To-Exceed cap
  laborRateId    String
  laborRate      LaborRate       @relation(fields: [laborRateId], references: [id])
  shopSuppliesPct Float          @default(0.035) // 3.5% of labor default
  notes          String?
  internalNotes  String?
  estimatedTotal Float?          // Quote total
  actualTotal    Float?          // Computed from actuals
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  squawks        Squawk[]
  lineItems      WorkOrderLineItem[]
  partRequests   PartRequest[]
  laborEntries   LaborEntry[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  milestones     BillingMilestone[]
  complianceItems ComplianceItem[]
}

enum WorkOrderType   { SCHEDULED AOG INSPECTION UNSCHEDULED }
enum WorkOrderStatus { OPEN IN_PROGRESS AWAITING_PARTS AWAITING_APPROVAL COMPLETE INVOICED CLOSED }
enum BillingModel    { FLAT_RATE TIME_AND_MATERIALS COST_PLUS NOT_TO_EXCEED HYBRID }

model WorkOrderLineItem {
  id           String          @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder       @relation(fields: [workOrderId], references: [id])
  taskNumber   String          // e.g. "TASK-001"
  description  String
  referenceDoc String?         // AD number, SB ref, STC ref
  estHours     Float           @default(0)
  actualHours  Float           @default(0)
  laborRate    Float           // rate at time of billing
  status       LineItemStatus  @default(PENDING)
  technicianId String?
  technician   Technician?     @relation(fields: [technicianId], references: [id])
  inspectedBy  String?
  approvedAt   DateTime?
  completedAt  DateTime?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  partRequests PartRequest[]
  laborEntries LaborEntry[]
}

enum LineItemStatus { PENDING IN_PROGRESS COMPLETE AWAITING_INSPECTION SIGNED_OFF }

// ─── Squawks (discrepancy approval workflow) ──────────────────────────────────

model Squawk {
  id              String       @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder    @relation(fields: [workOrderId], references: [id])
  description     String
  photoUrls       String[]     @default([])
  estLaborHours   Float?
  estPartsTotal   Float?
  estTotal        Float?
  status          SquawkStatus @default(PENDING_APPROVAL)
  isAirworthiness Boolean      @default(false) // mandatory for return to service
  approvedAt      DateTime?
  approvedBy      String?      // customer name / signature record
  declinedAt      DateTime?
  declineReason   String?
  lineItemId      String?      // linked after approval
  createdAt       DateTime     @default(now())
}

enum SquawkStatus { PENDING_APPROVAL APPROVED DECLINED DEFERRED }

// ─── Labor ───────────────────────────────────────────────────────────────────

model Technician {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  name           String
  certifications String[]     @default([]) // A&P, IA, ATP, etc.
  costRate       Float        // what shop pays ($/hr)
  billRate       Float        // what customer is billed ($/hr)
  active         Boolean      @default(true)
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  lineItems      WorkOrderLineItem[]
  laborEntries   LaborEntry[]
}

model LaborRate {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  name         String       // "Standard", "AOG", "Avionics", "After-Hours"
  rate         Float        // $/hour
  multiplier   Float        @default(1.0) // 1.5 for AOG
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())

  workOrders   WorkOrder[]
}

model LaborEntry {
  id           String     @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder  @relation(fields: [workOrderId], references: [id])
  lineItemId   String?
  lineItem     WorkOrderLineItem? @relation(fields: [lineItemId], references: [id])
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  date         DateTime
  hours        Float      // quarter-hour increments (0.25, 0.5, 0.75, 1.0...)
  rateUsed     Float      // snapshot of rate at time of entry
  billable     Boolean    @default(true)
  description  String?
  clockIn      DateTime?
  clockOut     DateTime?
  createdAt    DateTime   @default(now())
}

// ─── Parts & Procurement ─────────────────────────────────────────────────────

model Part {
  id           String        @id @default(cuid())
  orgId        String
  org          Organization  @relation(fields: [orgId], references: [id])
  partNumber   String
  altPartNumbers String[]    @default([])
  description  String
  condition    PartCondition @default(NEW)
  manufacturer String?
  qtyOnHand    Int           @default(0)
  unitCost     Float
  markupPct    Float         // computed from sliding scale
  bin          String?       // shelf/bin location
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([orgId, partNumber, condition])
}

enum PartCondition { NEW OH SV AR }  // New, Overhauled, Serviceable, As-Removed

model PartRequest {
  id              String            @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder         @relation(fields: [workOrderId], references: [id])
  lineItemId      String?
  lineItem        WorkOrderLineItem? @relation(fields: [lineItemId], references: [id])
  partNumber      String
  description     String
  qty             Int               @default(1)
  condition       PartCondition     @default(NEW)
  unitCost        Float?
  markupPct       Float?
  unitBillPrice   Float?
  requires8130    Boolean           @default(false)
  has8130         Boolean           @default(false)
  status          PartRequestStatus @default(REQUESTED)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  receivedAt      DateTime?
  createdAt       DateTime          @default(now())
}

enum PartRequestStatus { REQUESTED ON_ORDER RECEIVED INSTALLED CANCELLED }

model PurchaseOrder {
  id           String     @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  poNumber     String     @unique
  vendor       String
  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id])
  status       POStatus   @default(DRAFT)
  shippingCost Float      @default(0)
  expedited    Boolean    @default(false)
  priority     String?    // AOG, ROUTINE, DEFERRED
  expectedDate DateTime?
  receivedAt   DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  lineItems    POLineItem[]
  partRequests PartRequest[]
}

enum POStatus { DRAFT SUBMITTED ACKNOWLEDGED ON_ORDER PARTIALLY_RECEIVED RECEIVED CANCELLED }

model POLineItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  partNumber      String
  description     String
  qty             Int
  unitCost        Float
  condition       PartCondition @default(NEW)
  requires8130    Boolean       @default(false)
  receivedQty     Int           @default(0)
  receivedAt      DateTime?
}

// ─── Invoicing & Payments ─────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  orgId         String
  org           Organization  @relation(fields: [orgId], references: [id])
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  workOrderId   String?
  workOrder     WorkOrder?    @relation(fields: [workOrderId], references: [id])
  milestoneId   String?
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  sentAt        DateTime?
  viewedAt      DateTime?
  paidAt        DateTime?
  subtotal      Float
  taxRate       Float         @default(0)
  taxAmount     Float         @default(0)
  total         Float
  amountPaid    Float         @default(0)
  balance       Float
  isTrial       Boolean       @default(false) // trial invoice for customer review
  notes         String?
  internalNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lineItems     InvoiceLineItem[]
  payments      Payment[]
}

enum InvoiceStatus { DRAFT SENT VIEWED PARTIAL PAID OVERDUE VOID }

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  category    InvoiceLineCategory
  description String
  qty         Float   @default(1)
  unitPrice   Float
  total       Float
  taxable     Boolean @default(true)
  sortOrder   Int     @default(0)
}

enum InvoiceLineCategory { LABOR PARTS SHOP_SUPPLIES FREIGHT HANDLING SUBCONTRACT OTHER }

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amount      Float
  method      PaymentMethod
  reference   String?       // check #, transaction ID, etc.
  memo        String?
  paidAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())
}

enum PaymentMethod { CHECK ACH CREDIT_CARD CASH WIRE STRIPE }

// ─── Progressive Billing ──────────────────────────────────────────────────────

model BillingMilestone {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  name        String    // "50% Complete", "Engine Reinstalled", "Ready for Pickup"
  pct         Float     // percentage of total estimate to bill at this milestone
  sortOrder   Int       @default(0)
  triggeredAt DateTime?
  invoiceId   String?   @unique
  createdAt   DateTime  @default(now())
}

// ─── Compliance ──────────────────────────────────────────────────────────────

model ComplianceItem {
  id              String         @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder      @relation(fields: [workOrderId], references: [id])
  type            ComplianceType
  referenceId     String         // AD 2024-12-01, STC SA01234, etc.
  description     String
  form337Required Boolean        @default(false)
  form337Filed    Boolean        @default(false)
  form337FiledAt  DateTime?
  derFee          Float?
  stcFee          Float?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
}

enum ComplianceType { AD SB STC FORM_337 MAJOR_REPAIR MAJOR_ALTERATION }
